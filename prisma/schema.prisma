generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model addresses {
  address_id      Int               @id @default(autoincrement())
  customer_id     Int
  street          String?           @db.VarChar(255)
  city            String?           @db.VarChar(100)
  state           String?           @db.VarChar(100)
  zip_code        String?           @db.VarChar(20)
  country         String?           @db.VarChar(100)
  is_default      Boolean?          @default(false)
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  customers       customers         @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_addresses_customer")
  order_addresses order_addresses[]

  @@index([customer_id], map: "fk_addresses_customer")
}

model base_teas {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  // Soft-delete flag: retired options are marked inactive (never deleted or
  // renumbered) so historical recipes referencing them still read back.
  is_active     Boolean         @default(true)
  custom_blends custom_blends[]
  custom_orders custom_orders[]
}

model batch {
  batch_id       Int         @id @default(autoincrement())
  factory_id     Int
  field_id       Int
  harvested_date DateTime?   @db.Date
  factory        factory     @relation(fields: [factory_id], references: [factory_id], onUpdate: Restrict, map: "fk_batch_factory")
  field          field       @relation(fields: [field_id], references: [field_id], onUpdate: Restrict, map: "fk_batch_field")
  inventory      inventory[]
  product        product[]

  @@index([factory_id], map: "fk_batch_factory")
  @@index([field_id], map: "fk_batch_field")
}

model blend_spices {
  blend_id      Int
  spice_id      Int
  percentage    Decimal?      @db.Decimal(5, 2)
  custom_blends custom_blends @relation(fields: [blend_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_bs_blend")
  spices        spices        @relation(fields: [spice_id], references: [id], onUpdate: Restrict, map: "fk_bs_spice")

  @@id([blend_id, spice_id])
  @@index([spice_id], map: "fk_bs_spice")
}

model custom_blends {
  id           Int            @id @default(autoincrement())
  base_tea_id  Int
  quantity     Int
  created_at   DateTime?      @default(now()) @db.Timestamp(0)
  blend_spices blend_spices[]
  base_teas    base_teas      @relation(fields: [base_tea_id], references: [id], onUpdate: Restrict, map: "fk_blend_base_tea")

  @@index([base_tea_id], map: "fk_blend_base_tea")
}

model custom_orders {
  id           Int            @id @default(autoincrement())
  base_tea_id  Int
  quantity     Int
  created_at   DateTime?      @db.DateTime(0)
  base_teas    base_teas      @relation(fields: [base_tea_id], references: [id], onUpdate: Restrict, map: "fk_custom_order_base_tea")
  order_spices order_spices[]

  @@index([base_tea_id], map: "fk_custom_order_base_tea")
}

model customers {
  customer_id    Int         @id @default(autoincrement())
  first_name     String      @db.VarChar(100)
  last_name      String?     @db.VarChar(100)
  email          String?     @unique(map: "uq_customers_email") @db.VarChar(255)
  password       String?     @db.VarChar(255)
  contact_number String?     @db.VarChar(30)
  created_at     DateTime?   @default(now()) @db.Timestamp(0)
  updated_at     DateTime?   @default(now()) @db.Timestamp(0)
  addresses      addresses[]
  orders         orders[]
}

model factory {
  factory_id   Int     @id @default(autoincrement())
  factory_name String  @db.VarChar(150)
  other_info   String? @db.Text
  batch        batch[]
}

model field {
  field_id          Int        @id @default(autoincrement())
  plantation_id     Int
  field_information String?    @db.Text
  batch             batch[]
  plantation        plantation @relation(fields: [plantation_id], references: [plantation_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_field_plantation")

  @@index([plantation_id], map: "fk_field_plantation")
}

model inventory {
  inventory_id Int      @id @default(autoincrement())
  location_id  Int
  batch_id     Int
  quantity     Int      @default(0)
  batch        batch    @relation(fields: [batch_id], references: [batch_id], onUpdate: Restrict, map: "fk_inventory_batch")
  location     location @relation(fields: [location_id], references: [location_id], onUpdate: Restrict, map: "fk_inventory_location")

  @@index([batch_id], map: "fk_inventory_batch")
  @@index([location_id], map: "fk_inventory_location")
}

model location {
  location_id   Int         @id @default(autoincrement())
  location_name String      @db.VarChar(150)
  other_info    String?     @db.Text
  inventory     inventory[]
}

model order_addresses {
  order_id   Int
  address_id Int
  addresses  addresses @relation(fields: [address_id], references: [address_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_oa_address")
  orders     orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_oa_order")

  @@id([order_id, address_id])
  @@index([address_id], map: "fk_oa_address")
}

model order_spices {
  id            Int           @id @default(autoincrement())
  order_id      Int
  spice_name    String?       @db.VarChar(100)
  percentage    Decimal?      @db.Decimal(5, 2)
  custom_orders custom_orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_order_spices_order")

  @@index([order_id], map: "fk_order_spices_order")
}

model orders {
  order_id        Int               @id @default(autoincrement())
  customer_id     Int
  order_time      DateTime?         @db.DateTime(0)
  quantity        Int?
  total           Decimal?          @db.Decimal(10, 2)
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  order_addresses order_addresses[]
  customers       customers         @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_orders_customer")

  @@index([customer_id], map: "fk_orders_customer")
}

model paid_carts {
  cart_token String    @id @db.VarChar(255)
  paid_at    DateTime? @default(now()) @db.Timestamp(0)
}

// Submissions from the public "Contact Us" form. The stored row is the source
// of truth for an enquiry (email delivery, if configured, is layered on top and
// never gates the write). `ip`/`user_agent` are captured for abuse handling.
// The message is stored raw and untrusted — consumers MUST escape it on render.
model contact_messages {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  email      String    @db.VarChar(254)
  message    String    @db.Text
  ip         String?   @db.VarChar(45)
  user_agent String?   @db.VarChar(512)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_contact_messages_created_at")
}

model plantation {
  plantation_id   Int     @id @default(autoincrement())
  plantation_name String  @db.VarChar(150)
  tea_grade       String? @db.VarChar(100)
  field           field[]
}

model product {
  traceability_id Int     @id @default(autoincrement())
  batch_id        Int
  quantity        Int?
  product_name    String? @db.VarChar(150)
  batch           batch   @relation(fields: [batch_id], references: [batch_id], onUpdate: Restrict, map: "fk_product_batch")

  @@index([batch_id], map: "fk_product_batch")
}

model product_variants {
  shopify_variant_id     BigInt                 @id
  shopify_product_id     BigInt
  variant_title          String?                @db.VarChar(255)
  variant_price          Decimal?               @db.Decimal(10, 2)
  variant_weight         Decimal?               @db.Decimal(10, 2)
  variant_image_src      String?                @db.VarChar(1024)
  shopify_store_products shopify_store_products @relation(fields: [shopify_product_id], references: [shopify_product_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_variant_product")

  @@index([shopify_product_id], map: "fk_variant_product")
}

model shopify_products {
  shopify_variant_id BigInt   @id
  shopify_product_id BigInt
  title              String?  @db.VarChar(512)
  description        String?  @db.MediumText
  vendor             String?  @db.VarChar(255)
  product_type       String?  @db.VarChar(255)
  price              Decimal? @db.Decimal(10, 2)
  image_src          String?  @db.VarChar(1024)
}

model shopify_store_products {
  shopify_product_id BigInt             @id
  title              String?            @db.VarChar(512)
  description        String?            @db.MediumText
  vendor             String?            @db.VarChar(255)
  product_type       String?            @db.VarChar(255)
  image_src          String?            @db.VarChar(1024)
  created_at         DateTime?          @default(now()) @db.Timestamp(0)
  updated_at         DateTime?          @default(now()) @db.Timestamp(0)
  product_variants   product_variants[]
}

model spices {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(100)
  // Soft-delete flag: retired ingredients are marked inactive (never deleted or
  // renumbered) so historical recipes referencing them still read back.
  is_active    Boolean        @default(true)
  blend_spices blend_spices[]
}

model tea_products {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(150)
  category      String    @db.VarChar(100)
  price         Decimal   @db.Decimal(10, 2)
  originalPrice Decimal?  @default(0.00) @db.Decimal(10, 2)
  imageSrc      String?   @default("") @db.VarChar(512)
  tagline       String?   @default("") @db.VarChar(255)
  rating        Decimal?  @default(0.00) @db.Decimal(3, 2)
  reviewsCount  Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
}

// Idempotency log for Shopify webhooks. Shopify may deliver the same event more
// than once, so every delivery is recorded by its X-Shopify-Webhook-Id and a
// repeat delivery is acknowledged without being processed again.
model shopify_webhook_events {
  webhook_id    String    @id @db.VarChar(255)
  topic         String    @db.VarChar(100)
  shop_domain   String?   @db.VarChar(255)
  status        String    @default("received") @db.VarChar(20)
  error_message String?   @db.Text
  received_at   DateTime? @default(now()) @db.Timestamp(0)
  processed_at  DateTime? @db.Timestamp(0)

  @@index([topic], map: "idx_webhook_events_topic")
}

// Orders as they exist in Shopify (Shopify remains the source of truth for
// money and status). Kept separate from the internal `orders` table, which
// models our own supply-chain orders.
model shopify_orders {
  // Shopify ids are stored as strings: they exceed JS Number's 53-bit safe range,
  // so BigInt/Number would round the trailing digits (and the JSON output patch
  // would re-round them). Strings stay exact end to end.
  shopify_order_id   String                     @id @db.VarChar(32)
  order_number       String?                    @db.VarChar(50)
  email              String?                    @db.VarChar(255)
  financial_status   String?                    @db.VarChar(50)
  fulfillment_status String?                    @db.VarChar(50)
  currency           String?                    @db.VarChar(10)
  subtotal_amount    Decimal?                   @db.Decimal(10, 2)
  total_amount       Decimal?                   @db.Decimal(10, 2)
  cart_token         String?                    @db.VarChar(255)
  cancelled_at       DateTime?                  @db.DateTime(0)
  shopify_created_at DateTime?                  @db.DateTime(0)
  created_at         DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at         DateTime?                  @updatedAt @db.Timestamp(0)
  line_items         shopify_order_line_items[]
  machine_statuses   machine_order_statuses[]
  trace_code         trace_codes?

  @@index([email], map: "idx_shopify_orders_email")
  @@index([cart_token], map: "idx_shopify_orders_cart_token")
  // The machine feed pages by updated_at ascending.
  @@index([updated_at], map: "idx_shopify_orders_updated_at")
}

// Status reports the tea-dispensing machine writes back for an order (POST
// /api/machine/orders/status). Append-only log: one row per (order, status), so
// out-of-order arrivals and retries are naturally idempotent and no status ever
// overwrites another (e.g. a mid-blend cancellation still records `completed`).
model machine_order_statuses {
  id               Int            @id @default(autoincrement())
  shopify_order_id String         @db.VarChar(32)
  status           String         @db.VarChar(30)
  reason           String?        @db.VarChar(500)
  occurred_at      DateTime       @db.DateTime(3)
  received_at      DateTime?      @default(now()) @db.Timestamp(0)
  order            shopify_orders @relation(fields: [shopify_order_id], references: [shopify_order_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_machine_status_order")

  @@unique([shopify_order_id, status], map: "uq_machine_status_order_status")
  @@index([shopify_order_id], map: "fk_machine_status_order")
}

// Line items of a Shopify order. `properties` holds the cart-line attributes
// Shopify passes through (used for custom-blend details) as a JSON string —
// stored as TEXT rather than a JSON column to avoid MariaDB/Prisma JSON quirks.
model shopify_order_line_items {
  // All Shopify ids stored as strings — see the note in shopify_orders.
  line_item_id     String         @id @db.VarChar(32)
  shopify_order_id String         @db.VarChar(32)
  product_id       String?        @db.VarChar(32)
  variant_id       String?        @db.VarChar(32)
  title            String?        @db.VarChar(255)
  variant_title    String?        @db.VarChar(255)
  sku              String?        @db.VarChar(100)
  quantity         Int
  price            Decimal?       @db.Decimal(10, 2)
  blend_id         String?        @db.VarChar(100)
  properties       String?        @db.Text
  order            shopify_orders @relation(fields: [shopify_order_id], references: [shopify_order_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_line_items_shopify_order")
  allocations      order_allocations[]

  @@index([shopify_order_id], map: "fk_line_items_shopify_order")
  @@index([blend_id], map: "idx_line_items_blend_id")
}

// Public traceability codes — the 12-character string behind the QR on a label
// or invoice. One per Shopify order (enforced by uq_trace_codes_order).
//
// Codes are cryptographically random, never derived from the order number: the
// code is the only thing that keeps one customer's trace page separate from
// another's, so a guessable code would expose every order ever shipped.
// See src/lib/traceCode.js.
model trace_codes {
  code             String         @id @db.VarChar(12)
  shopify_order_id String         @unique(map: "uq_trace_codes_order") @db.VarChar(32)
  // active | revoked. Dispatch lives in dispatched_at, NOT here, so a shipped
  // code can still be revoked.
  status           String         @default("active") @db.VarChar(20)
  scan_count       Int            @default(0)
  first_scanned_at DateTime?      @db.DateTime(0)
  dispatched_at    DateTime?      @db.DateTime(0)
  created_at       DateTime?      @default(now()) @db.Timestamp(0)
  order            shopify_orders @relation(fields: [shopify_order_id], references: [shopify_order_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_trace_codes_order")

  @@index([status], map: "idx_trace_codes_status")
}

// ---------------------------------------------------------------------------
// Traceability chain. Models exactly the five details the public trace page
// shows: Plantation, Factory, Packed Date, Ingredients, Package Weight.
//
//   order line -> order_allocations -> pack_runs -> lots -> estates/factories
//
// The richer chain in the original brief (harvests, wither hours, moisture,
// cupping, shipments, Tea Board refs) was deliberately scoped out: it would
// need per-lot data entry from the estate, the factory and the shipping agent
// forever, and a page with blanks reads worse than a short page that is always
// complete. All of it can be added later as nullable columns or new tables
// hanging off `lots`, without reshaping any of this.
//
// NOTE: `estates`/`factories` are new. The unused legacy tables from an earlier
// phase (plantation, field, factory, batch, product, inventory, location) are
// untouched and should be dropped separately once production is confirmed empty.
// ---------------------------------------------------------------------------

// Tea estates — "Plantation" on the customer-facing page.
model estates {
  estate_id  Int       @id @default(autoincrement())
  name       String    @unique(map: "uq_estates_name") @db.VarChar(150)
  region     String?   @db.VarChar(100)
  // Soft delete (matching base_teas/spices): retired estates are marked
  // inactive, never deleted, so historic lots still read back.
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  lots       lots[]
}

// Tea factories. Separate from estates because a factory serves many lots and
// tea is not always manufactured on the estate that grew it.
model factories {
  factory_id Int       @id @default(autoincrement())
  name       String    @unique(map: "uq_factories_name") @db.VarChar(150)
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  lots       lots[]
}

// A manufactured lot — the unit that carries provenance. estate and factory are
// both required: a lot of unknown origin has no business on a trace page.
model lots {
  lot_id     Int         @id @default(autoincrement())
  lot_number String      @unique(map: "uq_lots_lot_number") @db.VarChar(50)
  estate_id  Int
  factory_id Int
  // e.g. "Golden Tips" — drives the pilot gating on the public endpoint.
  grade      String?     @db.VarChar(100)
  created_at DateTime?   @default(now()) @db.Timestamp(0)
  estate     estates     @relation(fields: [estate_id], references: [estate_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_lots_estate")
  factory    factories   @relation(fields: [factory_id], references: [factory_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_lots_factory")
  pack_runs  pack_runs[]

  @@index([estate_id], map: "fk_lots_estate")
  @@index([factory_id], map: "fk_lots_factory")
  @@index([grade], map: "idx_lots_grade")
}

// A packing run — one batch of retail units packed on one day. Supplies
// "Packed Date".
//
// lot_id is required, which is how "exactly one lot per pack run" is enforced:
// the database makes a run with no lot, or two lots, unrepresentable rather
// than trusting application code to check.
model pack_runs {
  pack_run_id        Int                 @id @default(autoincrement())
  // The identifier staff scan when packing an order.
  pack_run_code      String              @unique(map: "uq_pack_runs_code") @db.VarChar(50)
  lot_id             Int
  packed_date        DateTime            @db.Date
  // Shopify ids are strings throughout — they exceed JS Number's safe range.
  shopify_product_id String?             @db.VarChar(32)
  sku                String?             @db.VarChar(100)
  quantity_packed    Int?
  created_at         DateTime?           @default(now()) @db.Timestamp(0)
  lot                lots                @relation(fields: [lot_id], references: [lot_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pack_runs_lot")
  allocations        order_allocations[]

  @@index([lot_id], map: "fk_pack_runs_lot")
  @@index([shopify_product_id], map: "idx_pack_runs_product")
}

// Which pack run(s) fulfilled a given order line.
//
// One row per (line item, pack run), not per line item: an order line can span
// two pack runs when a run runs out mid-pick, so the quantity splits across
// rows. The database cannot check that the quantities sum to the line item's
// quantity — that cross-row rule lives in the packing endpoint.
model order_allocations {
  allocation_id Int                      @id @default(autoincrement())
  line_item_id  String                   @db.VarChar(32)
  pack_run_id   Int
  quantity      Int
  created_at    DateTime?                @default(now()) @db.Timestamp(0)
  line_item     shopify_order_line_items @relation(fields: [line_item_id], references: [line_item_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_order_allocations_line_item")
  pack_run      pack_runs                @relation(fields: [pack_run_id], references: [pack_run_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_allocations_pack_run")

  @@unique([line_item_id, pack_run_id], map: "uq_order_allocations_line_run")
  @@index([line_item_id], map: "fk_order_allocations_line_item")
  @@index([pack_run_id], map: "fk_order_allocations_pack_run")
}

// Per-product trace copy — "Ingredients" and "Package Weight" for standard
// products. No FK: shopify_store_products keys on BIGINT while every id in this
// chain is VARCHAR(32), and the two cannot be joined by a constraint.
//
// Custom blends take their ingredients from the order's own recipe instead
// (line_items.blend_id -> custom_blends -> blend_spices), since each is
// per-customer; the public endpoint prefers that when present.
model product_trace_info {
  shopify_product_id String    @id @db.VarChar(32)
  ingredients        String?   @db.VarChar(500)
  // Net weight in grams — numeric so it can be formatted per locale; the
  // frontend renders the unit.
  package_weight_g   Int?
  updated_at         DateTime? @default(now()) @db.Timestamp(0)
}
