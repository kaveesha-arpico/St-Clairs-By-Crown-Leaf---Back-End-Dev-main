# ---- Server ----
# Set to "production" when deployed: enables combined access logs and lets
# Express skip dev-only overhead. Leave unset (or "development") locally.
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed frontend origins for CORS. In production this
# MUST be your real frontend domain(s) — if unset, ALL origins are allowed.
FRONTEND_URL=http://localhost:5173

# ---- Database (MySQL / MariaDB) ----
# Used by the Prisma runtime driver adapter (src/config/prisma.js).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=tea_project

# Used by the Prisma CLI only (migrate / db pull / db seed), via prisma.config.ts.
# Must point at the same database as the DB_* vars above.
DATABASE_URL="mysql://root:your_db_password@localhost:3306/tea_project"

# ---- Auth (JWT) ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---- Shopify ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront/Admin GraphQL version (e.g. 2025-07). Bump here, not in code.
SHOPIFY_API_VERSION=2025-07

# Admin API access token from your custom app (Settings -> Apps -> Develop apps
# -> API credentials). Starts with shpat_. Sent via the X-Shopify-Access-Token
# header by src/lib/shopifyAdmin.js and the legacy shopify-api-node calls.
# SERVER-ONLY — never expose to the browser.
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_access_token

# PRIVATE Storefront token from the Headless channel (also starts with shpat_).
# Used SERVER-SIDE via the `Shopify-Storefront-Private-Token` header — this is
# what src/lib/shopifyStorefront.js and the /checkout call use. NOT the public
# token (which uses the X-Shopify-Storefront-Access-Token header from browsers).
SHOPIFY_STOREFRONT_TOKEN=your_private_storefront_token

# Shopify webhook signing secret (Settings -> Notifications -> Webhooks).
# Required for webhook routes to accept events (HMAC verification).
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# ---- Email (contact form notifications) — Microsoft Graph API ----
# OPTIONAL. If unset, contact submissions are still stored — only the email
# notification is skipped. Fill these to forward each enquiry to the shop inbox.
#
# Uses Microsoft Graph app-only (client-credentials) auth instead of SMTP:
# Microsoft is retiring SMTP AUTH, and contact@ is a SHARED mailbox with no
# password to SMTP-auth as. Setup (Microsoft Entra admin center, needs admin):
#   1. Entra ID -> App registrations -> New registration (single tenant).
#      Copy the Application (client) ID and Directory (tenant) ID.
#   2. Certificates & secrets -> New client secret -> copy the secret VALUE.
#   3. API permissions -> Microsoft Graph -> Application permissions ->
#      Mail.Send -> Add, then "Grant admin consent".
#   4. (Strongly recommended) In Exchange Online PowerShell, restrict the app to
#      ONLY the shop mailbox so it can't send as the whole tenant:
#        New-ApplicationAccessPolicy -AppId <client id> \
#          -PolicyScopeGroupId contact@crownandleaf.co.uk \
#          -AccessRight RestrictAccess -Description "St Clairs contact mailer"
GRAPH_TENANT_ID=your_directory_tenant_id
GRAPH_CLIENT_ID=your_application_client_id
GRAPH_CLIENT_SECRET=your_client_secret_value
# The mailbox to send AS (the shared inbox). Enquiries also default to landing here.
GRAPH_SENDER=contact@crownandleaf.co.uk
CONTACT_TO=contact@crownandleaf.co.uk
