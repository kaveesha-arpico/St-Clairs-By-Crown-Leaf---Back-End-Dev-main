# ---- Server ----
PORT=3000
# Comma-separated list of allowed frontend origins for CORS (used later in Day 2)
FRONTEND_URL=http://localhost:5173

# ---- Database (MySQL / MariaDB) ----
# Used by the Prisma runtime driver adapter (src/config/prisma.js).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=tea_project

# Used by the Prisma CLI only (migrate / db pull / db seed), via prisma.config.ts.
# Must point at the same database as the DB_* vars above.
DATABASE_URL="mysql://root:your_db_password@localhost:3306/tea_project"

# ---- Auth (JWT) ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---- Shopify Admin API (shopify-api-node) ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront/Admin GraphQL version (e.g. 2025-07). Bump here, not in code.
SHOPIFY_API_VERSION=2025-07
SHOPIFY_API_KEY=your_admin_api_key
SHOPIFY_API_PASSWORD=your_admin_api_password_or_access_token

# ---- Shopify Storefront API ----
# PRIVATE Storefront token from the Headless channel (starts with shpat_).
# Used SERVER-SIDE via the `Shopify-Storefront-Private-Token` header — this is
# what src/lib/shopifyStorefront.js and the /checkout call use. NOT the public
# token (which uses the X-Shopify-Storefront-Access-Token header from browsers).
SHOPIFY_STOREFRONT_TOKEN=your_private_storefront_token
# Used by shopify-buy client (src/lib/shopify.js) — public storefront token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# Shopify webhook signing secret. Required for the /api/payment-webhook route
# to accept events (HMAC verification). Without it, webhooks are rejected.
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret
