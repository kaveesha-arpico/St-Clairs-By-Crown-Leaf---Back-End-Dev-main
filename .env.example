# ---- Server ----
# Set to "production" when deployed: enables combined access logs and lets
# Express skip dev-only overhead. Leave unset (or "development") locally.
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed frontend origins for CORS. In production this
# MUST be your real frontend domain(s) — if unset, ALL origins are allowed.
FRONTEND_URL=http://localhost:5173

# ---- Database (MySQL / MariaDB) ----
# Used by the Prisma runtime driver adapter (src/config/prisma.js).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=tea_project

# Used by the Prisma CLI only (migrate / db pull / db seed), via prisma.config.ts.
# Must point at the same database as the DB_* vars above.
DATABASE_URL="mysql://root:your_db_password@localhost:3306/tea_project"

# ---- Auth (JWT) ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---- Shopify ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront/Admin GraphQL version (e.g. 2025-07). Bump here, not in code.
SHOPIFY_API_VERSION=2025-07

# Admin API access token from your custom app (Settings -> Apps -> Develop apps
# -> API credentials). Starts with shpat_. Sent via the X-Shopify-Access-Token
# header by src/lib/shopifyAdmin.js and the legacy shopify-api-node calls.
# SERVER-ONLY — never expose to the browser.
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_access_token

# PRIVATE Storefront token from the Headless channel (also starts with shpat_).
# Used SERVER-SIDE via the `Shopify-Storefront-Private-Token` header — this is
# what src/lib/shopifyStorefront.js and the /checkout call use. NOT the public
# token (which uses the X-Shopify-Storefront-Access-Token header from browsers).
SHOPIFY_STOREFRONT_TOKEN=your_private_storefront_token

# Shopify webhook signing secret (Settings -> Notifications -> Webhooks).
# Required for webhook routes to accept events (HMAC verification).
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret
